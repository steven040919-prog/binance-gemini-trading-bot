# ============================================================================
# CREDENCIALES OBLIGATORIAS (Configurar en GitHub Secrets en produccion)
# ============================================================================
BINANCE_API_KEY=tu_binance_api_key_aqui
BINANCE_API_SECRET=tu_binance_api_secret_aqui
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ============================================================================
# CONFIGURACION DE RED / PROXY (Importante para GitHub Actions)
# ============================================================================
# Los runners de GitHub Actions suelen estar en EE.UU. y Binance bloquea IPs de EE.UU. (HTTP 451)
# para endpoints privados de trading. Configura un proxy HTTP/SOCKS5 fuera de EE.UU.:
# Ejemplo: http://usuario:password@ip-proxy:puerto  o  socks5h://usuario:password@ip-proxy:puerto
BINANCE_PROXY_URL=

# ============================================================================
# MODO DE OPERACION Y MODELO IA
# ============================================================================
# false = Opera con dinero real en tu cuenta de Binance Spot
# true  = Simula las ordenes sin enviarlas a Binance (util para pruebas)
DRY_RUN=false

# Modelo de Gemini para toma de decisiones
GEMINI_MODEL=gemini-3.8-flash

# ============================================================================
# GESTION ESTRICTA DE RIESGO (Guardarrailes de seguridad)
# ============================================================================
QUOTE_ASSET=USDT
MAX_OPEN_POSITIONS=3
MAX_POSITION_PCT=0.25
MIN_ORDER_USDT=12.0
MIN_USDT_RESERVE=15.0

# Limites automaticos por posicion (0.035 = 3.5%, 0.07 = 7.0%, 0.025 = 2.5%)
STOP_LOSS_PCT=0.035
TAKE_PROFIT_PCT=0.070
TRAILING_STOP_PCT=0.025
TRAILING_ACTIVATION_PCT=0.030

# Cortacircuitos diario: si la cuenta cae mas de este % en el dia, bloquea compras nuevas
MAX_DAILY_DRAWDOWN_PCT=0.060

# Escaneo dinamico de mercado
TOP_CANDIDATES_LIMIT=8
MIN_24H_VOLUME_USDT=15000000
MIN_AI_CONFIDENCE=72
KLINE_INTERVAL_PRIMARY=15m
KLINE_INTERVAL_HTF=1h
