# ============================================================================
# CREDENCIALES OBLIGATORIAS (Configurar en GitHub Secrets en produccion)
# ============================================================================
BINANCE_API_KEY=tu_binance_api_key_aqui
BINANCE_API_SECRET=tu_binance_api_secret_aqui
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ============================================================================
# CONFIGURACION DE RED / PROXY (Importante para GitHub Actions)
# ============================================================================
BINANCE_PROXY_URL=

# ============================================================================
# MODO DE OPERACION Y MODELO IA
# ============================================================================
DRY_RUN=false
GEMINI_MODEL=gemini-3.8-flash
# "spot" (opera compras sobre EMA 200) o "futures" (opera LONG sobre EMA 200 y SHORT bajo EMA 200)
TRADING_MARKET=spot

# ============================================================================
# ESTRATEGIA: EMA 200 + ESTOCASTICO (80/20) + VELA MARTILLO / ENVOLVENTE (1H)
# ============================================================================
KLINE_INTERVAL_PRIMARY=1h
KLINE_INTERVAL_HTF=4h
EMA_TREND_PERIOD=200
STOCH_K_PERIOD=14
STOCH_SMOOTH_K=3
STOCH_D_PERIOD=3
STOCH_OVERBOUGHT=80.0
STOCH_OVERSOLD=20.0

# ============================================================================
# GESTION DE RIESGO (1% del monto total, minimo $1 USD)
# ============================================================================
QUOTE_ASSET=USDT
RISK_PER_TRADE_PCT=0.01
MIN_RISK_USD=1.0
MAX_OPEN_POSITIONS=3
MAX_POSITION_PCT=0.35
MIN_ORDER_USDT=1.0
MIN_USDT_RESERVE=1.0

# Cortacircuitos diario
MAX_DAILY_DRAWDOWN_PCT=0.050

# Escaneo dinamico de mercado
TOP_CANDIDATES_LIMIT=12
MIN_24H_VOLUME_USDT=10000000
MIN_AI_CONFIDENCE=70
